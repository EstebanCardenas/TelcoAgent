# ── Modelo local (Ollama) ────────────────────────────────────────────────
# qwen2.5:3b es el estándar recomendado del curso, pero puede usar cualquier
# modelo de Ollama con soporte de tool calling. El nombre del modelo nunca se
# escribe en el código: siempre se lee de aquí (get_settings().ollama_model).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Ventana de contexto con la que se invoca el modelo. Ollama usa 2048 tokens por
# defecto, que se quedan cortos cuando al prompt se suman los esquemas de las
# herramientas y los resultados acumulados. Súbalo o bájelo según el modelo.
OLLAMA_NUM_CTX=8192

# ── API empresarial del curso ────────────────────────────────────────────
# Cada equipo levanta su PROPIA instancia local con Docker (repositorio de
# la API entregado por el equipo docente): docker compose up -d
API_BASE_URL=http://localhost:8080

# Caso de negocio asignado: telecom | finanzas | centro_proyectos
CASO_NEGOCIO=telecom

# Número del grupo (solo presentación en el CLI)
GRUPO=00

# ── Base de conocimiento (RAG) — servicio central de la Universidad ─────────
# Información institucional pública (tiendas, horarios, planes y tarifas,
# políticas). NO se despliega por equipo: es un servicio central.
# Credenciales compartidas del curso para autenticarse y hacer /ask.
RAG_BASE_URL=
RAG_EMAIL=
RAG_PASSWORD=
RAG_COLLECTION=

# ── Agente 2 (Asesor de Retención) ─────────────────────────────────────────
# El Agente 1 llama a este URL cuando escala a retención. En Docker Compose
# el servicio `agente` usa http://agente2:8090.
AGENTE2_BASE_URL=http://localhost:8090
AGENTE2_HOST=127.0.0.1
AGENTE2_PORT=8090
AGENTE2_DB_PATH=data/retencion.sqlite

# ── LangSmith (se configura en la semana 3 ──────────────
# La llave (LANGCHAIN_API_KEY) la entrega el equipo docente. LangSmith también
# acepta los nombres nuevos LANGSMITH_TRACING / LANGSMITH_API_KEY /
# LANGSMITH_PROJECT, equivalentes a estos.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=misw4412-grupo00
